# Frontend environment variables (copy to .env and fill values)

# Base URL for backend API (e.g., https://api.example.com)
REACT_APP_API_BASE_URL=

# Public site URL used for OAuth/email redirects (e.g., https://app.example.com)
REACT_APP_SITE_URL=

# Payments provider used on client (documentation/conditional UI)
REACT_APP_PAYMENTS_PROVIDER=stripe

# Provider publishable key if using a client SDK (do NOT put secret keys here)
REACT_APP_PAYMENTS_PUBLISHABLE_KEY=
